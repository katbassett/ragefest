---
interface Props {
  variant?: "cards" | "compact";
  label?: string;
  targetDate?: string;
}

const {
  variant = "cards",
  label = "",
  targetDate = "2026-09-01T10:00:00-05:00",
} = Astro.props;

const units = [
  { id: "countdown-days", suffix: "D", label: "Days" },
  { id: "countdown-hours", suffix: "H", label: "Hrs" },
  { id: "countdown-minutes", suffix: "M", label: "Min" },
  { id: "countdown-seconds", suffix: "S", label: "Sec" },
];
---

{
  variant === "compact" ? (
    <div
      id="countdown"
      class="countdown-widget countdown-widget--compact"
      data-target-date={targetDate}
      data-countdown-variant="compact"
      aria-label={label || "Countdown"}
    >
      {label ? <p class="countdown-compact__label">{label}</p> : null}

      <p class="countdown-compact__track" aria-live="polite">
        <span class="countdown-compact__segment">
          <span id="countdown-days" class="countdown-compact__value">00</span>
          <span class="countdown-compact__suffix">D</span>
        </span>
        <span class="countdown-compact__sep" aria-hidden="true">:</span>
        <span class="countdown-compact__segment">
          <span id="countdown-hours" class="countdown-compact__value">00</span>
          <span class="countdown-compact__suffix">H</span>
        </span>
        <span class="countdown-compact__sep" aria-hidden="true">:</span>
        <span class="countdown-compact__segment">
          <span id="countdown-minutes" class="countdown-compact__value">00</span>
          <span class="countdown-compact__suffix">M</span>
        </span>
        <span class="countdown-compact__sep" aria-hidden="true">:</span>
        <span class="countdown-compact__segment">
          <span id="countdown-seconds" class="countdown-compact__value">00</span>
          <span class="countdown-compact__suffix">S</span>
        </span>
      </p>
    </div>
  ) : (
    <div
      id="countdown"
      class="countdown-widget"
      data-target-date={targetDate}
      aria-label="Countdown to Rage Fest"
    >
      {
        units.map((unit) => (
          <div class="countdown-unit">
            <span id={unit.id} class="countdown-value">
              00
            </span>

            <span class="countdown-label">{unit.label}</span>
          </div>
        ))
      }
    </div>
  )
}

<script>
  const countdown = document.querySelector<HTMLElement>("#countdown");

  const daysElement = document.querySelector<HTMLElement>("#countdown-days");
  const hoursElement = document.querySelector<HTMLElement>("#countdown-hours");
  const minutesElement =
    document.querySelector<HTMLElement>("#countdown-minutes");
  const secondsElement =
    document.querySelector<HTMLElement>("#countdown-seconds");

  let countdownInterval: number | undefined;

  const padNumber = (value: number) => String(value).padStart(2, "0");

  const setCountdownValues = (
    days: number,
    hours: number,
    minutes: number,
    seconds: number,
  ) => {
    if (daysElement) daysElement.textContent = padNumber(days);
    if (hoursElement) hoursElement.textContent = padNumber(hours);
    if (minutesElement) minutesElement.textContent = padNumber(minutes);
    if (secondsElement) secondsElement.textContent = padNumber(seconds);
  };

  const updateCountdown = () => {
    if (!countdown) return;

    const targetDateValue = countdown.dataset.targetDate;
    if (!targetDateValue) return;

    const targetTime = new Date(targetDateValue).getTime();

    if (Number.isNaN(targetTime)) {
      setCountdownValues(0, 0, 0, 0);
      return;
    }

    const distance = targetTime - Date.now();

    if (distance <= 0) {
      setCountdownValues(0, 0, 0, 0);

      if (countdownInterval) {
        window.clearInterval(countdownInterval);
      }

      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((distance / (1000 * 60)) % 60);
    const seconds = Math.floor((distance / 1000) % 60);

    setCountdownValues(days, hours, minutes, seconds);
  };

  const initCountdown = () => {
    if (!countdown || countdown.dataset.countdownReady === "true") return;
    countdown.dataset.countdownReady = "true";

    updateCountdown();
    countdownInterval = window.setInterval(updateCountdown, 1000);
  };

  initCountdown();
  document.addEventListener("astro:page-load", initCountdown);
</script>
