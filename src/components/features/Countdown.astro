---
interface Props {
  variant?: "cards" | "compact";
  label?: string;
  targetDate?: string;
}

const {
  variant = "cards",
  label = "",
  targetDate = "2026-09-01T10:00:00-05:00",
} = Astro.props;

const units = [
  { key: "days", suffix: "D", label: "Days" },
  { key: "hours", suffix: "H", label: "Hrs" },
  { key: "minutes", suffix: "M", label: "Min" },
  { key: "seconds", suffix: "S", label: "Sec" },
];
---

{
  variant === "compact" ? (
    <div
      class="countdown-widget countdown-widget--compact"
      data-countdown
      data-target-date={targetDate}
      data-countdown-variant="compact"
      aria-label={label || "Countdown"}
    >
      {label ? <p class="countdown-compact__label">{label}</p> : null}

      <p class="countdown-compact__track" aria-live="polite">
        <span class="countdown-compact__segment">
          <span class="countdown-compact__value" data-countdown-value="days">
            00
          </span>
          <span class="countdown-compact__suffix">D</span>
        </span>
        <span class="countdown-compact__sep" aria-hidden="true">:</span>
        <span class="countdown-compact__segment">
          <span class="countdown-compact__value" data-countdown-value="hours">
            00
          </span>
          <span class="countdown-compact__suffix">H</span>
        </span>
        <span class="countdown-compact__sep" aria-hidden="true">:</span>
        <span class="countdown-compact__segment">
          <span class="countdown-compact__value" data-countdown-value="minutes">
            00
          </span>
          <span class="countdown-compact__suffix">M</span>
        </span>
        <span class="countdown-compact__sep" aria-hidden="true">:</span>
        <span class="countdown-compact__segment">
          <span class="countdown-compact__value" data-countdown-value="seconds">
            00
          </span>
          <span class="countdown-compact__suffix">S</span>
        </span>
      </p>
    </div>
  ) : (
    <div
      class="countdown-widget"
      data-countdown
      data-target-date={targetDate}
      aria-label={label || "Countdown to Rage Fest"}
    >
      {label ? <p class="countdown-cards__label">{label}</p> : null}

      <div class="countdown-cards__grid">
        {
          units.map((unit) => (
            <div class="countdown-unit">
              <span class="countdown-value" data-countdown-value={unit.key}>
                00
              </span>

              <span class="countdown-label">{unit.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  )
}

<script>
  const padNumber = (value: number) => String(value).padStart(2, "0");

  const initCountdown = (countdown: HTMLElement) => {
    if (countdown.dataset.countdownReady === "true") return;
    countdown.dataset.countdownReady = "true";

    const daysElement = countdown.querySelector<HTMLElement>(
      '[data-countdown-value="days"]',
    );
    const hoursElement = countdown.querySelector<HTMLElement>(
      '[data-countdown-value="hours"]',
    );
    const minutesElement = countdown.querySelector<HTMLElement>(
      '[data-countdown-value="minutes"]',
    );
    const secondsElement = countdown.querySelector<HTMLElement>(
      '[data-countdown-value="seconds"]',
    );

    const setCountdownValues = (
      days: number,
      hours: number,
      minutes: number,
      seconds: number,
    ) => {
      if (daysElement) daysElement.textContent = padNumber(days);
      if (hoursElement) hoursElement.textContent = padNumber(hours);
      if (minutesElement) minutesElement.textContent = padNumber(minutes);
      if (secondsElement) secondsElement.textContent = padNumber(seconds);
    };

    const updateCountdown = () => {
      const targetDateValue = countdown.dataset.targetDate;
      if (!targetDateValue) return;

      const targetTime = new Date(targetDateValue).getTime();

      if (Number.isNaN(targetTime)) {
        setCountdownValues(0, 0, 0, 0);
        return;
      }

      const distance = targetTime - Date.now();

      if (distance <= 0) {
        setCountdownValues(0, 0, 0, 0);
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((distance / (1000 * 60)) % 60);
      const seconds = Math.floor((distance / 1000) % 60);

      setCountdownValues(days, hours, minutes, seconds);
    };

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  };

  const initAllCountdowns = () => {
    document
      .querySelectorAll<HTMLElement>("[data-countdown]")
      .forEach(initCountdown);
  };

  initAllCountdowns();
  document.addEventListener("astro:page-load", initAllCountdowns);
</script>
