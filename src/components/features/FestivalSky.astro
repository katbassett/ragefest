---
---

<div class="festival-sky" aria-hidden="true">
  <div class="festival-sky__base"></div>

  <div class="festival-sky__layer festival-sky__layer--night" data-sky="night"></div>
  <div class="festival-sky__layer festival-sky__layer--sunset" data-sky="sunset"></div>
  <div class="festival-sky__layer festival-sky__layer--day" data-sky="day"></div>

  <div class="festival-sky__wash" data-sky-wash></div>

  <div class="festival-sky__leaks" data-sky-leaks>
    <span class="festival-sky__leak festival-sky__leak--a"></span>
    <span class="festival-sky__leak festival-sky__leak--b"></span>
    <span class="festival-sky__leak festival-sky__leak--c"></span>
    <span class="festival-sky__leak festival-sky__leak--d"></span>
    <span class="festival-sky__leak festival-sky__leak--e"></span>
  </div>

  <div class="festival-sky__beams" data-sky-beams>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="festival-sky__scan" data-sky-scan></div>
  <div class="festival-sky__grain"></div>
</div>

<script>
  const clamp = (value: number, min = 0, max = 1) =>
    Math.min(max, Math.max(min, value));

  const smoothstep = (t: number) => t * t * (3 - 2 * t);

  type PhasePoint = { y: number; ph: number };

  const initFestivalSky = () => {
    const world = document.querySelector(".festival-world");
    const day = document.querySelector<HTMLElement>('[data-sky="day"]');
    const sunset = document.querySelector<HTMLElement>('[data-sky="sunset"]');
    const night = document.querySelector<HTMLElement>('[data-sky="night"]');
    const leaks = document.querySelector<HTMLElement>("[data-sky-leaks]");
    const scan = document.querySelector<HTMLElement>("[data-sky-scan]");
    const wash = document.querySelector<HTMLElement>("[data-sky-wash]");
    const beams = document.querySelector<HTMLElement>("[data-sky-beams]");

    if (!world || !day || !sunset || !night) return;
    if (world instanceof HTMLElement && world.dataset.skyReady === "true") return;
    if (world instanceof HTMLElement) world.dataset.skyReady = "true";

    let frameRequested = false;
    let phases: PhasePoint[] = [];

    const buildPhases = () => {
      const markers: Array<{ selector: string; ph: number }> = [
        { selector: "#lineup", ph: 0.58 },
        { selector: "#tickets", ph: 0.72 },
        { selector: "#experience", ph: 0.82 },
        { selector: "#experience .world-hidden", ph: 0.92 },
        { selector: "#faq", ph: 1 },
      ];

      phases = markers
        .map(({ selector, ph }) => {
          const el = document.querySelector(selector);
          if (!(el instanceof HTMLElement)) return null;

          const y =
            el.getBoundingClientRect().top +
            window.scrollY +
            el.offsetHeight * 0.2;

          return { y, ph };
        })
        .filter((point): point is PhasePoint => point !== null)
        .sort((a, b) => a.y - b.y);
    };

    const phaseAt = (cy: number) => {
      if (!phases.length) return 0;
      if (cy <= phases[0].y) return phases[0].ph;

      const last = phases[phases.length - 1];
      if (cy >= last.y) return last.ph;

      for (let i = 0; i < phases.length - 1; i += 1) {
        const a = phases[i];
        const b = phases[i + 1];

        if (cy >= a.y && cy <= b.y) {
          const t = smoothstep((cy - a.y) / Math.max(b.y - a.y, 1));
          return a.ph + (b.ph - a.ph) * t;
        }
      }

      return 1;
    };

    const updateSky = () => {
      frameRequested = false;

      const focusY = window.scrollY + window.innerHeight * 0.48;
      const phase = clamp(phaseAt(focusY));

      const dayOpacity = clamp(1 - phase * 2);
      const sunsetOpacity = clamp(1 - Math.abs(phase - 0.5) * 2);
      const nightOpacity = clamp(phase * 2 - 1);

      day.style.opacity = dayOpacity.toFixed(3);
      sunset.style.opacity = sunsetOpacity.toFixed(3);
      night.style.opacity = nightOpacity.toFixed(3);

      if (leaks) {
        // Brighter leaks through sunset, softer at deep night
        const leakOpacity =
          0.42 + sunsetOpacity * 0.28 + nightOpacity * 0.12;
        leaks.style.opacity = leakOpacity.toFixed(3);
      }

      if (scan) {
        scan.style.opacity = (nightOpacity * 0.5).toFixed(3);
      }

      if (wash) {
        wash.style.opacity = (0.18 + sunsetOpacity * 0.22 + nightOpacity * 0.12).toFixed(
          3,
        );
      }

      if (beams) {
        beams.style.opacity = (nightOpacity * 0.55).toFixed(3);
      }

      document.documentElement.style.setProperty(
        "--rf-sky-phase",
        phase.toFixed(3),
      );
      document.documentElement.style.setProperty(
        "--rf-sky-sunset",
        sunsetOpacity.toFixed(3),
      );
      document.documentElement.style.setProperty(
        "--rf-sky-night",
        nightOpacity.toFixed(3),
      );
    };

    const requestSkyUpdate = () => {
      if (frameRequested) return;
      frameRequested = true;
      window.requestAnimationFrame(updateSky);
    };

    buildPhases();
    updateSky();

    window.addEventListener("scroll", requestSkyUpdate, { passive: true });
    window.addEventListener("resize", () => {
      buildPhases();
      requestSkyUpdate();
    });
  };

  initFestivalSky();
  document.addEventListener("astro:page-load", initFestivalSky);
</script>
