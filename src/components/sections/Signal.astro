---
import logoIcon from "../../assets/navigation/logo-icon.png";
---

<section id="signal" class="signal-section" aria-labelledby="signal-title">
  <div class="signal-shell">
    <div class="signal-cta">
      <img
        class="signal-cta__eyes"
        src={logoIcon.src}
        alt=""
        width={logoIcon.width}
        height={logoIcon.height}
      />

      <p class="signal-cta__eyebrow">The Waitlist</p>

      <h2 id="signal-title" class="signal-cta__title">
        <span class="signal-cta__title-main">Join The Signal</span>
      </h2>

      <p class="signal-cta__text">
        Get first access to every lineup drop, ticket release, and hidden
        announcement, plus priority pricing and founding-community status.
      </p>

      <form class="signal-signup" action="#" method="post">
        <label class="visually-hidden" for="signal-email">Email address</label>
        <input
          id="signal-email"
          type="email"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
        />
        <button class="join-waitlist-btn signal-signup__btn" type="submit">
          <span>Join The Signal</span>
        </button>
      </form>

      <ul class="signal-cta__benefits">
        <li>Priority access</li>
        <li>Lowest pricing</li>
        <li>Secret drops</li>
      </ul>
    </div>
  </div>
</section>

<script>
  const initSignalReveal = () => {
    const section = document.querySelector("#signal");
    const cta = document.querySelector("#signal .signal-cta");

    if (!section || !cta) return;
    if (section.dataset.revealReady === "true") return;

    section.dataset.revealReady = "true";

    const show = () => {
      if (section.dataset.revealed === "true") return;
      section.dataset.revealed = "true";
      cta.classList.add("is-visible");
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      show();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            show();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
    );

    observer.observe(section);
  };

  initSignalReveal();
  document.addEventListener("astro:page-load", initSignalReveal);

  const initSignalSignup = () => {
    const form = document.querySelector("#signal .signal-signup");
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.ready === "true") return;

    form.dataset.ready = "true";
    form.addEventListener("submit", (event) => {
      event.preventDefault();
    });
  };

  initSignalSignup();
  document.addEventListener("astro:page-load", initSignalSignup);
</script>

<style>
  .signal-section {
    position: relative;
    z-index: 1;
    isolation: isolate;

    padding:
      clamp(1.5rem, 3vh, 2.5rem)
      0
      clamp(3.5rem, 6vh, 5rem);

    color: #ffffff;
    background: transparent;
  }

  .signal-shell {
    width: min(calc(100% - clamp(1.25rem, 5vw, 4rem)), 76.25rem);
    margin-inline: auto;
  }

  .signal-cta {
    display: flex;
    flex-direction: column;
    align-items: center;

    padding: clamp(2.25rem, 5vw, 3.5rem) clamp(1.35rem, 3vw, 2.5rem);

    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1.35rem;

    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(255, 32, 131, 0.28),
        transparent 55%
      ),
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.08) 0%,
        rgba(138, 43, 226, 0.18) 55%,
        rgba(0, 0, 0, 0.28) 100%
      );

    text-align: center;

    opacity: 0;
    transform: translate3d(0, 1.5rem, 0);

    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .signal-cta.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .signal-cta__eyes {
    width: clamp(3.5rem, 7vw, 5rem);
    height: auto;
    margin-bottom: 0.85rem;

    filter: drop-shadow(0 0 14px rgba(255, 32, 131, 0.55));
  }

  .signal-cta__eyebrow {
    margin: 0 0 0.65rem;

    color: var(--rf-yellow);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .signal-cta__title {
    margin: 0 0 0.85rem;
  }

  .signal-cta__title-main {
    display: block;

    color: #ffffff;

    font-family: "Road Rage", cursive;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 0.95;
    text-transform: none;

    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.45);
  }

  .signal-cta__text {
    max-width: 38rem;
    margin: 0 auto 1.6rem;

    color: rgba(255, 255, 255, 0.82);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .signal-signup {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;

    width: min(100%, 34rem);
  }

  .signal-signup input {
    flex: 1 1 14rem;

    min-width: 0;
    padding: 1rem 1.15rem;

    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0.35rem;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .signal-signup input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .signal-signup input:focus {
    outline: none;
    border-color: var(--rf-yellow);
    box-shadow: 0 0 0 3px rgba(245, 255, 0, 0.2);
  }

  .signal-signup__btn {
    flex: none;
    padding: 1rem 1.85rem;
    font-size: 0.74rem;
  }

  .signal-cta__benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem 0.75rem;

    margin: 1.4rem 0 0;
    padding: 0;

    list-style: none;
  }

  .signal-cta__benefits li {
    padding: 0.45rem 0.8rem;

    color: rgba(255, 255, 255, 0.88);
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .signal-cta {
      align-items: center;
      padding-inline: 1.15rem;
    }

    .signal-signup {
      width: 100%;
    }

    .signal-signup__btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-cta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
