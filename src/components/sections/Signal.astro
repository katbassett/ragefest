---
import logoIcon from "../../assets/navigation/logo-icon.png";
---

<section id="signal" class="signal-section" aria-labelledby="signal-title">
  <div class="signal-shell">
    <div class="signal-cta">
      <img
        class="signal-cta__eyes"
        src={logoIcon.src}
        alt=""
        width={logoIcon.width}
        height={logoIcon.height}
      />

      <p class="signal-cta__eyebrow">The Waitlist</p>

      <h2 id="signal-title" class="signal-cta__title">
        <span class="signal-cta__title-main">Join The Signal</span>
      </h2>

      <p class="signal-cta__text">
        Get first access to every lineup drop, ticket release, and hidden
        announcement, plus priority pricing and founding-community status.
      </p>

      <form class="signal-signup" action="#" method="post">
        <label class="visually-hidden" for="signal-email">Email address</label>
        <input
          id="signal-email"
          type="email"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
        />
        <button class="join-waitlist-btn signal-signup__btn" type="submit">
          <span>Join The Signal</span>
        </button>
      </form>

      <p class="signal-signup__status" data-signal-status hidden></p>

      <ul class="signal-cta__benefits">
        <li>Priority access</li>
        <li>Lowest pricing</li>
        <li>Secret drops</li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { submitWaitlistEmail } from "../../scripts/waitlist";

  const initSignalReveal = () => {
    const section = document.querySelector("#signal");
    const cta = document.querySelector("#signal .signal-cta");

    if (!section || !cta) return;
    if (section.dataset.revealReady === "true") return;

    section.dataset.revealReady = "true";

    const show = () => {
      if (section.dataset.revealed === "true") return;
      section.dataset.revealed = "true";
      cta.classList.add("is-visible");
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      show();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            show();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
    );

    observer.observe(section);
  };

  initSignalReveal();
  document.addEventListener("astro:page-load", initSignalReveal);

  const initSignalSignup = () => {
    const form = document.querySelector("#signal .signal-signup");
    const status = document.querySelector<HTMLElement>("[data-signal-status]");

    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.ready === "true") return;

    form.dataset.ready = "true";

    const setStatus = (message: string, tone: "ok" | "err" | "idle" = "idle") => {
      if (!status) return;
      status.hidden = !message;
      status.textContent = message;
      status.dataset.tone = tone;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const emailInput = form.elements.namedItem("email");
      if (!(emailInput instanceof HTMLInputElement)) return;

      const email = emailInput.value.trim();
      if (!email) return;

      const button = form.querySelector("button[type='submit']");
      if (button instanceof HTMLButtonElement) button.disabled = true;
      setStatus("Sending…", "idle");

      const result = await submitWaitlistEmail(email, "signal");

      if (button instanceof HTMLButtonElement) button.disabled = false;

      if (result.ok) {
        setStatus("You’re on The Signal. We’ll be in touch.", "ok");
        form.reset();
      } else if (result.reason === "invalid") {
        setStatus("Enter a valid email address.", "err");
      } else {
        setStatus("Something went wrong. Try again in a moment.", "err");
      }
    });
  };

  initSignalSignup();
  document.addEventListener("astro:page-load", initSignalSignup);
</script>
