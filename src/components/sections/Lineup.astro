---
import logoIcon from "../../assets/navigation/logo-icon.png";

/**
 * Flip to true to restore the three phase cards + next-drop strip.
 * Kept in place so the phased lineup layout can come back later.
 */
const showPhaseReleases = false;

const signals = [
  {
    signal: "Signal 01",
    date: "Phase 1",
    title: "First Wave",
    description:
      "The first artists drop and the journey starts. A taste of the sound before the world expands.",
    includes: "Opening artists",
    status: "Incoming",
    className: "lineup-card--signal-01",
    graphic: "wave",
  },
  {
    signal: "Signal 02",
    date: "Phase 2",
    title: "The World Expands",
    description:
      "More artists land, experience reveals unlock, and new corners of the island come into view.",
    includes: "Artists + experiences",
    status: "Locked",
    className: "lineup-card--signal-02",
    graphic: "expand",
  },
  {
    signal: "Signal 03",
    date: "Phase 3",
    title: "Full Reveal",
    description:
      "The complete lineup, headliner, and final event details land before we hit the island.",
    includes: "Full lineup + headliner",
    status: "Classified",
    className: "lineup-card--signal-03",
    graphic: "strobe",
  },
];

const nextDrop = signals[0];

/** Unrevealed festival lineup silhouette (headliner → support) */
const hiddenLineup = [
  { size: "xl", names: ["???????????????????"] },
  { size: "lg", names: ["?????????", "???????????"] },
  { size: "md", names: ["???????", "????????", "???????"] },
  { size: "sm", names: ["??????", "???????", "?????", "????????"] },
  { size: "xs", names: ["?????", "??????", "???????", "?????", "?????"] },
  { size: "xxs", names: ["????", "?????", "??????", "?????", "?????", "????"] },
];
---

<section id="lineup" class="lineup-section">
  <div class="lineup-shell">
    <header class="lineup-head">
      <p class="lineup-kicker">The Sound</p>

      <h2 class="lineup-title">
        <span class="lineup-title__main">A Journey,</span>
        <span class="lineup-title__accent">Not a Playlist</span>
      </h2>

      <p class="lineup-lead">
        {
          showPhaseReleases
            ? "The sound unlocks in waves, not all at once."
            : "We know who's playing. You don't. Yet."
        }
      </p>
    </header>

    {
      showPhaseReleases ? (
        <aside class="lineup-next" aria-label="Next release">
          <div class="lineup-next__meta">
            <p class="lineup-next__frame">Three Releases · One Lineup</p>
            <p class="lineup-next__label">Next Drop</p>
            <p class="lineup-next__signal">{nextDrop.signal}</p>
          </div>

          <div class="lineup-next__main">
            <p class="lineup-next__date">{nextDrop.date}</p>
            <p class="lineup-next__title">{nextDrop.title}</p>
            <p class="lineup-next__detail">{nextDrop.includes}</p>
          </div>

          <p class="lineup-next__status">{nextDrop.status}</p>
        </aside>
      ) : (
        <aside class="lineup-locked" aria-label="Lineup incoming">
          <div class="lineup-locked__fx" aria-hidden="true">
            <span class="lineup-locked__glow"></span>
            <span class="lineup-locked__core-glow"></span>
            <span class="lineup-locked__scan"></span>
            <span class="lineup-locked__grain"></span>
            <span class="lineup-locked__lasers">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </div>

          <div class="lineup-locked__top">
            <p>RAGEFEST 2027</p>
            <p>SOUTH PADRE</p>
          </div>

          <div class="lineup-locked__stage">
            <div class="lineup-locked__hidden" data-redacted aria-hidden="true">
              {hiddenLineup.map((row) => (
                <p class:list={["lineup-locked__names", `lineup-locked__names--${row.size}`]}>
                  {row.names.map((name) => (
                    <span class="lineup-locked__name">{name}</span>
                  ))}
                </p>
              ))}
            </div>

            <div class="lineup-locked__center">
              <img
                class="lineup-locked__eyes"
                src={logoIcon.src}
                alt=""
                width={logoIcon.width}
                height={logoIcon.height}
              />
              <div class="lineup-locked__titles">
                <p class="lineup-locked__lineup">Lineup</p>
                <p class="lineup-locked__incoming">Incoming</p>
              </div>
            </div>
          </div>

          <div class="lineup-locked__bottom">
            <div class="lineup-locked__copy">
              <p class="lineup-locked__headline">First names drop soon.</p>
              <p class="lineup-locked__hint">
                Get the reveal before everyone else.
              </p>
            </div>

            <a class="join-waitlist-btn lineup-locked__cta" href="#signal">
              <span>Join The Signal →</span>
            </a>

            <div class="lineup-locked__codes">
              <span>03.19.27</span>
              <span>RF // 001</span>
              <span>SOUTH PADRE ISLAND</span>
            </div>
          </div>
        </aside>
      )
    }

    {
      showPhaseReleases && (
        <div class="lineup-grid">
          {signals.map((signal) => (
            <article
              class:list={["lineup-card", "lineup-card--signal", signal.className]}
            >
              <div class="lineup-card__fx" aria-hidden="true">
                <span class="lineup-scan"></span>

                {signal.graphic === "wave" && (
                  <span
                    class="lineup-graphic lineup-graphic--ocean"
                    aria-hidden="true"
                  >
                    <span class="lineup-ocean-line"></span>
                    <span class="lineup-ocean-line lineup-ocean-line--soft"></span>
                  </span>
                )}

                {signal.graphic === "expand" && (
                  <span class="lineup-graphic lineup-graphic--expand">
                    <span></span>
                    <span></span>
                    <span></span>
                  </span>
                )}

                {signal.graphic === "strobe" && (
                  <span class="lineup-graphic lineup-graphic--strobe">
                    <span class="lineup-laser lineup-laser--cyan"></span>
                    <span class="lineup-laser lineup-laser--pink"></span>
                    <span class="lineup-laser lineup-laser--yellow"></span>
                    <span class="lineup-laser lineup-laser--magenta"></span>
                    <span class="lineup-laser lineup-laser--white"></span>
                  </span>
                )}
              </div>

              <div class="lineup-card__top">
                <p class="lineup-card__eyebrow">{signal.signal}</p>
                <p class="lineup-card__status">{signal.status}</p>
              </div>

              <div class="lineup-card__body">
                <p class="lineup-card__date">{signal.date}</p>
                <h3 class="lineup-card__title">{signal.title}</h3>
                <p class="lineup-card__detail">{signal.description}</p>
              </div>

              <div class="lineup-card__foot">
                <p class="lineup-card__includes">{signal.includes}</p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  const initLineupReveal = () => {
    const section = document.querySelector("#lineup");
    const next = document.querySelector(
      "#lineup .lineup-next, #lineup .lineup-locked",
    );
    const cards = Array.from(
      document.querySelectorAll("#lineup .lineup-card"),
    );

    if (!section || (!next && cards.length === 0)) return;
    if (section.dataset.revealReady === "true") return;

    section.dataset.revealReady = "true";

    const showCards = () => {
      if (section.dataset.revealed === "true") return;
      section.dataset.revealed = "true";

      const startDelay = 80;

      if (next) {
        window.setTimeout(() => {
          next.classList.add("is-visible");
        }, startDelay);
      }

      cards.forEach((card, index) => {
        window.setTimeout(() => {
          card.classList.add("is-visible");
        }, startDelay + 120 + index * 140);
      });
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      next?.classList.add("is-visible");
      cards.forEach((card) => card.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            showCards();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
    );

    observer.observe(section);
  };

  initLineupReveal();
  document.addEventListener("astro:page-load", initLineupReveal);

  const initRedactedGlitch = () => {
    const board = document.querySelector("#lineup [data-redacted]");
    if (!(board instanceof HTMLElement)) return;
    if (board.dataset.ready === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    board.dataset.ready = "true";
    const names = Array.from(board.querySelectorAll(".lineup-locked__name"));

    board.addEventListener("pointermove", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (!target.classList.contains("lineup-locked__name")) return;

      target.classList.add("is-glitching");
      window.setTimeout(() => target.classList.remove("is-glitching"), 420);
    });

    window.setInterval(() => {
      if (document.hidden || names.length === 0) return;
      const name = names[Math.floor(Math.random() * names.length)];
      name.classList.add("is-glitching");
      window.setTimeout(() => name.classList.remove("is-glitching"), 280);
    }, 2200);
  };

  initRedactedGlitch();
  document.addEventListener("astro:page-load", initRedactedGlitch);
</script>
