---
const faqs = [
  {
    question: "What is RAGE?",
    answer:
      "RAGEFEST is a one-day destination experience — a hidden world that only exists once a year on South Padre Island. Music, mystery, community, and storytelling. Not another EDM festival. Presence over performance, sun to strobe.",
  },
  {
    question: "Where is RAGE?",
    answer: "South Padre Island, Texas.",
  },
  {
    question: "When is RAGE?",
    answer: "March 19, 2027 — one day only.",
  },
  {
    question: "Is this 18+ or 21+?",
    answer: "RAGEFEST is 18+.",
  },
];
---

<section id="faq" class="faq-section">
  <div class="faq-shell">
    <header class="faq-head">
      <p class="faq-kicker">FAQ</p>

      <h2 class="faq-title">
        <span class="faq-title__main">Know Before</span>
        <span class="faq-title__accent">You Rage</span>
      </h2>

      <p class="faq-lead">
        The basics — what it is, where it lives, and when it hits
      </p>
    </header>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-item__question">
              <span>{faq.question}</span>
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <p class="faq-item__answer">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    position: relative;
    z-index: 1;
    isolation: isolate;

    padding:
      clamp(1.75rem, 3vh, 2.75rem)
      0
      clamp(6.75rem, 13vh, 10.5rem);

    color: #ffffff;
    background: transparent;
  }

  .faq-shell {
    width: min(calc(100% - clamp(1.25rem, 5vw, 4rem)), 52.5rem);
    margin-inline: auto;
  }

  .faq-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;

    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .faq-kicker {
    margin: 0;

    color: var(--rf-yellow);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;

    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.43);
  }

  .faq-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.06em;

    margin: 0;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(2.1rem, 5.2vw, 3.8rem);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .faq-title__main {
    color: #ffffff;

    font-family: "Road Rage", cursive;
    font-size: 1.28em;
    font-weight: 400;
    letter-spacing: 0.02em;

    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.43);
  }

  .faq-title__accent {
    color: var(--rf-pink);
    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.43);
  }

  .faq-lead {
    max-width: 42rem;
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0;
    text-transform: none;

    text-shadow: none;
  }

  .faq-list {
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;

    padding: 1.15rem 0.2rem;

    list-style: none;
    cursor: pointer;

    color: #ffffff;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1.15rem, 2.6vw, 1.65rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-transform: uppercase;

    transition:
      padding 250ms ease,
      background 250ms ease;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question::marker {
    content: "";
  }

  .faq-item__question:hover {
    padding-left: 0.75rem;

    background: linear-gradient(
      90deg,
      rgba(255, 32, 131, 0.12),
      transparent 70%
    );
  }

  .faq-item[open] .faq-item__question {
    color: var(--rf-yellow);
  }

  .faq-item__icon {
    position: relative;
    flex: none;

    width: 1rem;
    height: 1rem;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: "";

    position: absolute;
    top: 50%;
    left: 50%;

    width: 100%;
    height: 2px;

    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 220ms ease, opacity 220ms ease;
  }

  .faq-item[open] .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
    opacity: 0;
  }

  .faq-item__answer {
    max-width: 42rem;
    margin: 0;
    padding: 0 0.2rem 1.35rem;

    color: rgba(255, 255, 255, 0.84);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    font-weight: 500;
    line-height: 1.6;
  }

  @media (max-width: 680px) {
    .faq-kicker {
      font-size: 0.62rem;
      letter-spacing: 0.16em;
    }

    .faq-title {
      font-size: clamp(2.1rem, 10vw, 3rem);
    }

    .faq-item__question {
      font-size: 1.15rem;
    }
  }
</style>
