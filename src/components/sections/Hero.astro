---
import Container from "../primitives/Container.astro";
import Countdown from "../features/Countdown.astro";

const eventDate = "2027-03-19T18:00:00-04:00";
---

<section id="home" class="hero-section">
  <div class="hero-background" aria-hidden="true">
    <div class="hero-sky"></div>

    <img
      src="/assets/hero/tropical-background.png"
      alt=""
      class="hero-tropical-background"
    />

    <div class="hero-sun"></div>
    <div class="hero-texture"></div>
    <div class="hero-haze"></div>

    <img
      src="/assets/hero/clouds-top-overlay.png"
      alt=""
      class="hero-clouds-top"
    />

    <div class="hero-lasers">
      <span class="hero-laser hero-laser-one"></span>
      <span class="hero-laser hero-laser-two"></span>
      <span class="hero-laser hero-laser-three"></span>
    </div>
  </div>

  <div class="hero-main">
    <Container class="hero-container">
      <div class="hero-layout">
        <div class="hero-content hero-content--conversion">
          <h1 class="hero-logo-wrap">
            <img
              src="/RF-textLogo_Primary.png"
              alt="RageFest"
              class="hero-logo-image"
              width="1527"
              height="306"
              decoding="async"
              fetchpriority="high"
            />
          </h1>

          <p class="hero-meta">
            <span class="hero-meta__chunk">South Padre Island</span>
            <span class="hero-meta__sep" aria-hidden="true"> · </span>
            <span class="hero-meta__chunk">March 19, 2027</span>
          </p>

          <h2 class="hero-title">
            <span class="hero-title__line">
              <span class="hero-title__chunk">Party</span>
              <span class="hero-title__chunk">by Day</span>
            </span>
            <span class="hero-title__line hero-title__line--rage">
              <span class="hero-title__chunk">Rage</span>
              <span class="hero-title__chunk">by Night</span>
            </span>
          </h2>

          <article class="hero-pass" aria-label="Founders Access ticket offer">
            <div class="ticket-card__fx" aria-hidden="true">
              <span class="ticket-card__scan"></span>
              <span class="ticket-card__glow"></span>
              <span class="ticket-card__sheen"></span>
              <span class="ticket-card__orb ticket-card__orb--one"></span>
              <span class="ticket-card__orb ticket-card__orb--two"></span>
            </div>

            <div class="hero-pass__main">
              <div class="hero-pass__admit">
                <h3 class="hero-pass__name">Founders Access</h3>
              </div>

              <div class="hero-pass__tear" aria-hidden="true"></div>

              <div class="hero-pass__details">
                <p class="hero-pass__price">$59 · Only 500 Tickets</p>
                <p class="hero-pass__window">September 1–30</p>
              </div>
            </div>
          </article>

          <div class="hero-actions">
            <a href="#tickets" class="hero-secondary-button">
              <span>Get Founders Access</span>

              <svg
                viewBox="0 0 24 24"
                class="hero-secondary-icon"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
          </div>

          <div class="hero-countdown hero-countdown--compact">
            <Countdown
              variant="compact"
              label="Gates to Rage Open In"
              targetDate={eventDate}
            />
          </div>
        </div>

        <p class="hero-description hero-description--bottom">
          A spring break entertainment experience powered by bass music culture.
        </p>
      </div>
    </Container>
  </div>

  <div class="festival-ticker">
    <div class="festival-ticker-track">
      <span>Freedom</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Music</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Memories</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Unpredictable</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Always Watching</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Chaos</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Community</span>
      <span class="festival-ticker-symbol">✦</span>

      <span aria-hidden="true">Freedom</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Music</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Memories</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Unpredictable</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Always Watching</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Chaos</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Community</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
    </div>
  </div>
</section>
