---
import Container from "../primitives/Container.astro";
import Countdown from "../features/Countdown.astro";

const foundersAccessOpens = "2026-09-01T10:00:00-05:00";
---

<section id="home" class="hero-section">
  <div class="hero-background" aria-hidden="true">
    <div class="hero-sky"></div>

    <img
      src="/assets/hero/tropical-background.png"
      alt=""
      class="hero-tropical-background"
    />

    <div class="hero-sun"></div>
    <div class="hero-texture"></div>
    <div class="hero-haze"></div>

    <img
      src="/assets/hero/clouds-top-overlay.png"
      alt=""
      class="hero-clouds-top"
    />

    <div class="hero-lasers">
      <span class="hero-laser hero-laser-one"></span>
      <span class="hero-laser hero-laser-two"></span>
      <span class="hero-laser hero-laser-three"></span>
    </div>
  </div>

  <div class="hero-main">
    <Container class="hero-container">
      <div class="hero-layout">
        <div class="hero-content hero-content--conversion">
          <h1 class="hero-logo-wrap">
            <img
              src="/RF-textLogo_Primary.png"
              alt="RageFest"
              class="hero-logo-image"
              width="1527"
              height="306"
              decoding="async"
              fetchpriority="high"
            />
          </h1>

          <p class="hero-meta">
            South Padre Island · March 19, 2027
          </p>

          <h2 class="hero-title">
            <span class="hero-title__line">Day Drink.</span>
            <span class="hero-title__line hero-title__line--rage">Night Rage.</span>
          </h2>

          <div class="hero-pass" aria-label="Founders Access ticket offer">
            <div class="hero-pass__fx" aria-hidden="true">
              <span class="hero-pass__scan"></span>
            </div>

            <div class="hero-pass__inner">
              <div class="hero-pass__row">
                <span class="hero-pass__label">Founders Access</span>
                <span class="hero-pass__badge">Limited Drop</span>
              </div>

              <p class="hero-pass__price">$59 · Only 500 Tickets</p>
              <p class="hero-pass__window">September 1–30</p>
            </div>
          </div>

          <div class="hero-actions">
            <a href="#tickets" class="join-waitlist-btn hero-cta-primary">
              <span>Get Founders Access →</span>
            </a>
          </div>

          <div class="hero-countdown">
            <Countdown
              variant="compact"
              label="Founders Access Opens In"
              targetDate={foundersAccessOpens}
            />
          </div>
        </div>

        <p class="hero-description hero-description--bottom">
          A spring break entertainment experience powered by bass music culture.
        </p>
      </div>
    </Container>
  </div>

  <div class="festival-ticker">
    <div class="festival-ticker-track">
      <span>Freedom</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Music</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Memories</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Unpredictable</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Always Watching</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Chaos</span>
      <span class="festival-ticker-symbol">✦</span>
      <span>Community</span>
      <span class="festival-ticker-symbol">✦</span>

      <span aria-hidden="true">Freedom</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Music</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Memories</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Unpredictable</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Always Watching</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Chaos</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
      <span aria-hidden="true">Community</span>
      <span class="festival-ticker-symbol" aria-hidden="true">✦</span>
    </div>
  </div>
</section>
