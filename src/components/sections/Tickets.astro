---
import { ticketShop, useDemoShop } from "../../data/ticket-shop";

/* Full ladder kept for later — flip showFullLadder when ready */
const showFullLadder = false;

const allTiers = [
  {
    name: "Founding Access",
    tagline: "The first and lowest-priced RAGEFEST ticket.",
    status: "Extremely Limited",
    featured: true,
    className: "ticket-card--founding",
    features: [
      "General Admission",
      "Extremely limited release",
      "Founding Attendee designation",
      "Early supporter recognition",
      "Potential first access to merchandise and future presales",
      "Once this tier is gone, this price will never return",
    ],
  },
  {
    name: "Early Access",
    tagline: "Get in before standard GA pricing begins.",
    status: "Limited Release",
    featured: false,
    className: "ticket-card--early",
    features: [
      "General Admission",
      "Limited early release",
      "Full general festival access",
      "Lower price for purchasing early",
      "Available for a limited time or until sold out",
    ],
  },
  {
    name: "GA Tier 1",
    tagline: "Standard General Admission.",
    status: "First Public Tier",
    featured: false,
    className: "ticket-card--ga1",
    features: [
      "Full general festival access",
      "First standard public ticket tier",
      "Price increases when Tier 1 sells out",
    ],
  },
  {
    name: "GA Tier 2",
    tagline: "The next General Admission release.",
    status: "Next Release",
    featured: false,
    className: "ticket-card--ga2",
    features: [
      "Full general festival access",
      "Same access as GA Tier 1",
      "Higher price as ticket inventory decreases",
      "Available until this tier sells out",
    ],
  },
  {
    name: "Final Tier",
    tagline: "The final General Admission release.",
    status: "Last GA",
    featured: false,
    className: "ticket-card--final",
    features: [
      "Full general festival access",
      "Limited remaining inventory",
      "Final GA price before sellout",
    ],
  },
  {
    name: "VIP",
    tagline: "A limited premium RAGEFEST experience.",
    status: "$299 · 150 Available",
    featured: false,
    className: "ticket-card--vip",
    features: [
      "Festival admission",
      "Event Center access",
      "Premium VIP experience",
      "Additional VIP amenities to be announced",
      "Only 150 VIP tickets available",
      "No additional VIP tickets will be released after this allocation",
    ],
  },
];

const foundingTier = allTiers.find((tier) => tier.name === "Founding Access");
const vipTier = allTiers.find((tier) => tier.name === "VIP");

const tiers = showFullLadder
  ? allTiers
  : allTiers.filter((tier) => tier.name === "Founding Access");

type PurchaseBlock = {
  id: "founding" | "vip";
  tier: (typeof allTiers)[number];
  blockClass: string;
  checkoutTitle: string;
  widgetLabel: string;
  buyLabel: string;
  itemId?: string;
  closedMessage: string;
  showTierLabel: boolean;
};

const purchaseBlocks: PurchaseBlock[] = [
  foundingTier && {
    id: "founding",
    tier: foundingTier,
    blockClass: "tickets-purchase tickets-purchase--founding",
    checkoutTitle: "Secure Your Access",
    widgetLabel: "FOUNDING ACCESS",
    buyLabel: "Buy Founding Access",
    itemId: ticketShop.foundingAccessItemId,
    closedMessage:
      "The ticket shop isn’t open yet. Founding Access goes live on the 20th.",
    showTierLabel: false,
  },
  vipTier && {
    id: "vip",
    tier: vipTier,
    blockClass: "tickets-purchase tickets-purchase--vip",
    checkoutTitle: "Secure VIP Access",
    widgetLabel: "VIP",
    buyLabel: "Claim VIP Access",
    itemId: ticketShop.vipItemId,
    closedMessage: "VIP checkout is temporarily unavailable. Check back soon.",
    showTierLabel: true,
  },
].filter((block): block is PurchaseBlock => Boolean(block));
---

<section id="tickets" class="tickets-section">
  <div class="tickets-shell">
    <header class="tickets-head">
      <p class="tickets-kicker">Tickets • Access</p>

      <h2 class="tickets-title">
        <span class="tickets-title__main">Buy Into</span>
        <span class="tickets-title__accent">The World</span>
      </h2>
    </header>

    {
      showFullLadder ? (
        <div class="tickets-grid">
          {
            tiers.map((tier) => (
              <article
                class:list={[
                  "ticket-card",
                  tier.className,
                  tier.featured && "ticket-card--featured",
                ]}
              >
                <div class="ticket-card__fx" aria-hidden="true">
                  <span class="ticket-card__scan"></span>
                  <span class="ticket-card__glow"></span>
                  <span class="ticket-card__sheen"></span>
                  <span class="ticket-card__orb ticket-card__orb--one"></span>
                  <span class="ticket-card__orb ticket-card__orb--two"></span>
                </div>

                {tier.featured && (
                  <p class="ticket-card__flag">Believers move first</p>
                )}

                <div class="ticket-card__main">
                  <div class="ticket-card__top">
                    <div class="ticket-card__heading">
                      <h3 class="ticket-card__name">{tier.name}</h3>
                      <p class="ticket-card__tagline">{tier.tagline}</p>
                    </div>
                    <p class="ticket-card__status">{tier.status}</p>
                  </div>

                  <ul class="ticket-card__features">
                    {tier.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      ) : (
        purchaseBlocks.map((block) => (
          <div class="tickets-purchase-group">
            {block.showTierLabel && (
              <p class="tickets-tier-label">{block.tier.name}</p>
            )}

            <div class={block.blockClass}>
              <div
                class="ticket-card__fx tickets-purchase__fx"
                aria-hidden="true"
              >
                <span class="ticket-card__scan"></span>
                <span class="ticket-card__glow"></span>
                <span class="ticket-card__sheen"></span>
                <span class="ticket-card__orb ticket-card__orb--one"></span>
                <span class="ticket-card__orb ticket-card__orb--two"></span>
              </div>

              <article
                class:list={[
                  "ticket-card",
                  block.tier.className,
                  block.tier.featured && "ticket-card--featured",
                  "ticket-card--banner",
                ]}
              >
                <div class="ticket-card__main">
                  <div class="ticket-card__top">
                    <div class="ticket-card__heading">
                      <h3 class="ticket-card__name">{block.tier.name}</h3>
                      <p class="ticket-card__tagline">{block.tier.tagline}</p>
                    </div>
                    <p class="ticket-card__status">{block.tier.status}</p>
                  </div>

                  <ul class="ticket-card__features">
                    {block.tier.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
              </article>

              <div class="tickets-checkout">
                <h3 class="tickets-checkout__title">{block.checkoutTitle}</h3>

                {
                  block.itemId ? (
                    <div
                      class="tickets-widget"
                      data-loop1-widget
                      data-tier={block.id}
                      data-widget-label={block.widgetLabel}
                      data-buy-label={block.buyLabel}
                      data-closed-message={block.closedMessage}
                      data-shop-list={ticketShop.productListUrl}
                      data-shop-event={ticketShop.eventUrl}
                    >
                      {
                        useDemoShop && (
                          <p class="tickets-widget__preview">
                            Preview widget (pretix demo) — not live Ragefest
                            tickets
                          </p>
                        )
                      }

                      <p class="tickets-widget__status" data-loop1-status>
                        Checking the ticket shop…
                      </p>

                      <div
                        class="pretix-widget-compat"
                        event={ticketShop.eventUrl}
                        items={block.itemId}
                      ></div>

                      <noscript>
                        <div class="pretix-widget">
                          <div class="pretix-widget-info-message">
                            JavaScript is disabled in your browser. To access
                            our ticket shop without JavaScript, please{" "}
                            <a
                              target="_blank"
                              rel="noopener"
                              href={ticketShop.eventUrl}
                            >
                              click here
                            </a>.
                          </div>
                        </div>
                      </noscript>
                    </div>
                  ) : (
                    <p class="tickets-widget__status tickets-widget__status--static">
                      {block.closedMessage}
                    </p>
                  )
                }
              </div>
            </div>
          </div>
        ))
      )
    }

    <p class="tickets-checkout__close">
      <span class="tickets-checkout__close-lead">The first gate is open.</span>
      <span>
        Founding Access and VIP are available now. More tiers will reveal
        themselves later.
      </span>
    </p>
  </div>
</section>

<script>
  const initTicketsReveal = () => {
    const section = document.querySelector("#tickets");
    const cards = Array.from(
      document.querySelectorAll(
        "#tickets .tickets-purchase, #tickets .tickets-grid .ticket-card",
      ),
    );

    if (!section || cards.length === 0) return;
    if (section instanceof HTMLElement && section.dataset.revealReady === "true")
      return;
    if (section instanceof HTMLElement) section.dataset.revealReady = "true";

    const showCards = () => {
      if (section instanceof HTMLElement && section.dataset.revealed === "true")
        return;
      if (section instanceof HTMLElement) section.dataset.revealed = "true";

      cards.forEach((card, index) => {
        window.setTimeout(() => {
          card.classList.add("is-visible");
        }, 80 + index * 120);
      });
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cards.forEach((card) => card.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          showCards();
          observer.disconnect();
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );

    observer.observe(section);
  };

  initTicketsReveal();
  document.addEventListener("astro:page-load", initTicketsReveal);

  const initLoop1ShopStatus = () => {
    document.querySelectorAll<HTMLElement>("[data-loop1-widget]").forEach((root) => {
      const status = root.querySelector<HTMLElement>("[data-loop1-status]");
      if (!status) return;
      if (root.dataset.statusReady === "true") return;
      root.dataset.statusReady = "true";

      const shopList = root.dataset.shopList;
      const shopEvent =
        root.dataset.shopEvent ||
        "https://loop1tickets.com/Ragefest/Ragefest2027/";
      const closedMessage =
        root.dataset.closedMessage ||
        "The ticket shop isn’t open yet. Check back soon.";

      if (!shopList) return;

      fetch(shopList)
        .then((response) => response.json())
        .then((data) => {
          if (data && data.error) {
            root.dataset.shop = "disabled";
            status.textContent = closedMessage;
            return;
          }

          root.dataset.shop = "live";
          status.hidden = true;
        })
        .catch(() => {
          root.dataset.shop = "error";
          status.innerHTML =
            'The ticket shop couldn’t load here. <a href="' +
            shopEvent +
            '" target="_blank" rel="noopener">Open it in a new tab</a>.';
        });
    });
  };

  const relabelLoop1Copy = (root: HTMLElement) => {
    const widgetLabel = root.dataset.widgetLabel?.trim() || "FOUNDING ACCESS";
    const buyLabel = root.dataset.buyLabel?.trim() || "Buy tickets";

    root.querySelectorAll(".pretix-widget-item-title").forEach((node) => {
      if (node.textContent?.trim() === widgetLabel) return;
      node.textContent = widgetLabel;
    });

    root.querySelectorAll(".pretix-widget-action button").forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      if (node.getAttribute("aria-label") === buyLabel) return;
      node.setAttribute("aria-label", buyLabel);
    });
  };

  const initLoop1Presentation = () => {
    document.querySelectorAll<HTMLElement>("[data-loop1-widget]").forEach((root) => {
      if (root.dataset.presentationReady === "true") return;
      root.dataset.presentationReady = "true";

      relabelLoop1Copy(root);

      let pending = false;

      const observer = new MutationObserver(() => {
        if (pending) return;
        pending = true;

        window.requestAnimationFrame(() => {
          pending = false;
          relabelLoop1Copy(root);
        });
      });

      observer.observe(root, {
        subtree: true,
        childList: true,
      });
    });
  };

  initLoop1ShopStatus();
  initLoop1Presentation();
  document.addEventListener("astro:page-load", initLoop1ShopStatus);
  document.addEventListener("astro:page-load", initLoop1Presentation);
</script>

<script>
  import { initTicketWidgetTracking } from "../../scripts/ticket-purchase";

  initTicketWidgetTracking();
  document.addEventListener("astro:page-load", initTicketWidgetTracking);
</script>
