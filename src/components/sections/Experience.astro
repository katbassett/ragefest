---
import logoIcon from "../../assets/navigation/logo-icon.png";

const phases = [
  {
    number: "01 · Doors → Golden Hour",
    title: "Day",
    mood: "Escape",
    tags: ["Curiosity", "Exploration", "Freedom"],
    description:
      "Arrive, wander the world, feel the weight of the week fall away. Ocean, palms, beach games, friends.",
    className: "s2s-col--day",
  },
  {
    number: "02 · Golden Hour",
    title: "Sunset",
    mood: "Transformation",
    tags: ["Anticipation", "Connection", "Awakening"],
    description:
      "The light shifts, the Signal stirs, and the crowd becomes one. Rage starts to appear. Something is coming.",
    className: "s2s-col--sunset",
  },
  {
    number: "03 · After Dark",
    title: "Night",
    mood: "Release",
    tags: ["Euphoria", "Energy", "Catharsis"],
    description:
      "The Eyes awaken — bass, neon, lasers, fire. Pure release until the last strobe.",
    className: "s2s-col--night",
  },
];

const hiddenPlaces = [
  {
    number: "01",
    name: "The Presence Pit",
    tag: "The heart of the floor",
  },
  {
    number: "02",
    name: "Signal Shore",
    tag: "Beach, after dark",
  },
  {
    number: "03",
    name: "Reset + Hydration",
    tag: "Recharge",
  },
  {
    number: "04",
    name: "VIP Oasis",
    tag: "Elevated",
  },
  {
    number: "05",
    name: "Creator Studio",
    tag: "Capture it",
  },
  {
    number: "06",
    name: "Discovery Corridor",
    tag: "Secrets between zones",
  },
  {
    number: "07",
    name: "Memory Wall",
    tag: "Leave your mark",
  },
];
---

<section
  id="experience"
  class="s2s-section"
  data-scroll-phase="sunset-start"
>
  <div class="s2s-shell">
    <header class="s2s-head">
      <p class="s2s-kicker">The Experience</p>

      <div class="s2s-heading">
        <h2 class="s2s-title">
          <span class="s2s-title__day">One Day</span>
          <span class="s2s-title__accent">Three Transformations</span>
        </h2>

        <p class="s2s-lead">
          Guests don’t watch a lineup — they move through a feeling
        </p>
      </div>
    </header>

    <div class="s2s">
      {
        phases.map((phase) => (
          <article class:list={["s2s-col", phase.className]}>
            <div class="s2s-col__body">
              <span class="s2s-num">{phase.number}</span>
              <h3>{phase.title}</h3>
              <p class="s2s-mood">{phase.mood}</p>

              <ul class="s2s-tags">
                {phase.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>

              <p class="s2s-copy">{phase.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="world-hidden">
      <header class="world-hidden__head">
        <p class="s2s-kicker">The Experience</p>

        <h2 class="s2s-title world-hidden__title">
          <span class="s2s-title__day">What Else</span>
          <span class="s2s-title__accent">Is Hidden There?</span>
        </h2>

        <p class="world-hidden__lead">
          A world with more corners than we’ll show you here. A few of the
          places you’ll find inside — the rest you discover in person.
        </p>
      </header>

      <div class="world-list">
        {
          hiddenPlaces.map((place) => (
            <div class="world-row">
              <span class="world-row__num">{place.number}</span>
              <span class="world-row__name">{place.name}</span>
              <span class="world-row__tag">{place.tag}</span>
            </div>
          ))
        }
      </div>

      <p class="world-more">
        <img
          class="world-more__eyes"
          src={logoIcon.src}
          alt=""
          width={logoIcon.width}
          height={logoIcon.height}
        />
        <span>And more you’ll only find once you’re inside.</span>
      </p>
    </div>
  </div>
</section>

<script>
  const initExperienceReveal = () => {
    const section = document.querySelector("#experience");
    const cards = Array.from(
      document.querySelectorAll(".s2s-col"),
    );

    if (!section || cards.length === 0) return;
    if (section.dataset.revealReady === "true") return;

    section.dataset.revealReady = "true";

    const showCards = () => {
      if (section.dataset.revealed === "true") return;
      section.dataset.revealed = "true";

      cards.forEach((card, index) => {
        window.setTimeout(() => {
          card.classList.add("is-visible");
        }, index * 900);
      });
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cards.forEach((card) => card.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          showCards();
          observer.disconnect();
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -10% 0px",
      },
    );

    observer.observe(section);

    // Fallback if the section is already on screen when the script runs
    const rect = section.getBoundingClientRect();
    if (rect.top < window.innerHeight * 0.88 && rect.bottom > 0) {
      showCards();
      observer.disconnect();
    }
  };

  initExperienceReveal();
  document.addEventListener("astro:page-load", initExperienceReveal);
</script>

<style>
  .s2s-section {
    position: relative;
    z-index: 1;
    isolation: isolate;
    overflow: hidden;

    padding:
      clamp(5.75rem, 12vh, 9.5rem)
      0
      clamp(3.5rem, 6vh, 5rem);

    color: #ffffff;
    background: transparent;
  }

  .s2s-shell {
    width: min(calc(100% - clamp(1.25rem, 5vw, 4rem)), 76.25rem);
    margin-inline: auto;
  }

  .s2s-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;

    max-width: 48rem;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);

    text-align: center;
  }

  .s2s-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .s2s-shell > .s2s-head {
    align-items: flex-start;

    max-width: none;
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);

    text-align: left;
  }

  .s2s-shell > .s2s-head .s2s-heading,
  .s2s-shell > .s2s-head .s2s-title {
    align-items: flex-start;
  }

  .s2s-shell > .s2s-head .s2s-lead {
    justify-content: flex-start;
    text-align: left;
  }

  .s2s-kicker {
    display: inline-flex;
    align-items: center;

    margin: 0;

    color: var(--rf-yellow);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;

    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.43);
  }

  .s2s-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.06em;

    margin: 0;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(2.1rem, 5.2vw, 3.8rem);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .s2s-title span {
    display: block;
  }

  .s2s-title__day {
    color: #ffffff;

    font-family: "Road Rage", cursive;
    font-size: 1.28em;
    font-weight: 400;
    letter-spacing: 0.02em;

    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.43);
  }

  .s2s-title__accent {
    color: var(--rf-pink);
    white-space: nowrap;
    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.43);
  }

  .s2s-lead {
    max-width: 42rem;
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0;
    text-transform: none;

    text-shadow: none;
  }

  .s2s {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .s2s-col {
    position: relative;
    overflow: hidden;

    display: flex;
    flex-direction: column;
    justify-content: center;

    min-height: clamp(23rem, 32vw, 30rem);
    padding: clamp(1.75rem, 3vw, 2.75rem);

    border-radius: 1.15rem;
    color: #ffffff;

    opacity: 0;
    transform: translate3d(-2.5rem, 0, 0);

    transition:
      opacity 4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .s2s-col.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .s2s-col__body {
    position: relative;
    z-index: 1;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;

    width: 100%;
    text-align: center;
  }

  .s2s-num {
    display: block;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;

    opacity: 0.8;
  }

  .s2s-col h3 {
    margin: 0;

    color: #ffffff;

    font-family: "Road Rage", cursive;
    font-size: clamp(2.2rem, 4.4vw, 3.35rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .s2s-mood {
    margin: 0;

    color: #ffffff;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    opacity: 0.92;
  }

  .s2s-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;

    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .s2s-tags li {
    padding: 0.3em 0.7em;

    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.18);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .s2s-copy {
    max-width: 28ch;
    margin: 0.35rem 0 0;

    color: #ffffff;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.55;
    text-align: center;

    opacity: 0.92;
  }

  .s2s-col--day {
    background: linear-gradient(
      180deg,
      var(--rf-blue) 0%,
      var(--rf-yellow) 100%
    );
  }

  .s2s-col--day::before {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 0;

    background: rgba(0, 0, 0, 0.32);
    pointer-events: none;
  }

  .s2s-col--sunset {
    background: linear-gradient(
      180deg,
      var(--rf-orange) 0%,
      var(--rf-pink) 100%
    );
  }

  .s2s-col--night {
    background: linear-gradient(
      180deg,
      var(--rf-purple) 0%,
      #000000 100%
    );
  }

  /* Hidden world list — closer to reference hlist */

  .world-hidden {
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .world-hidden__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;

    max-width: 52.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);

    text-align: left;
  }

  .world-hidden__title {
    align-items: flex-start;
  }

  .world-hidden__lead {
    max-width: 42rem;
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0;
    text-transform: none;

    text-shadow: none;
  }

  .world-list {
    width: min(100%, 52.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .world-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;

    padding: 0.95rem 0.2rem;

    border-bottom: 1px solid rgba(255, 255, 255, 0.18);

    transition:
      padding 250ms ease,
      background 250ms ease;
  }

  .world-row:hover {
    padding-left: 1rem;

    background: linear-gradient(
      90deg,
      rgba(255, 32, 131, 0.12),
      transparent 70%
    );
  }

  .world-row__num {
    flex: none;
    width: 2.6ch;

    color: rgba(255, 255, 255, 0.55);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .world-row__name {
    color: #ffffff;

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: clamp(1.35rem, 3.4vw, 2.4rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;

    transform: skewX(-4deg);
  }

  .world-row__tag {
    margin-left: auto;

    color: var(--rf-blue);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .world-more {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;

    margin: 1.5rem 0 0;

    color: var(--rf-yellow);

    font-family: var(--font-sans, "Montserrat", sans-serif);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    text-shadow: 0 2px 7px rgba(0, 0, 0, 0.4);
  }

  .world-more__eyes {
    width: 2.1rem;
    height: auto;

    filter: drop-shadow(0 0 10px rgba(255, 32, 131, 0.45));
  }

  @media (max-width: 820px) {
    .s2s {
      grid-template-columns: 1fr;
    }

    .s2s-col {
      min-height: 20rem;
    }
  }

  @media (max-width: 600px) {
    .s2s-section {
      padding-block: 5.25rem 3.5rem;
    }

    .s2s-kicker {
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      line-height: 1.5;
    }

    .s2s-title {
      font-size: clamp(1.9rem, 9vw, 2.8rem);
    }

    .world-row {
      gap: 0.85rem;
    }

    .world-row__tag {
      display: none;
    }

    .world-more {
      align-items: flex-start;
      max-width: 22rem;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .s2s-col {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .world-row {
      transition: none;
    }
  }
</style>
