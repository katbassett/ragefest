---
import logoIcon from "../../assets/navigation/logo-icon.png";

const phases = [
  {
    number: "01 · Doors → Golden Hour",
    title: "Day",
    mood: "Escape",
    tags: ["Curiosity", "Exploration", "Freedom"],
    description:
      "Arrive, wander the world, feel the weight of the week fall away. Ocean, palms, beach games, friends.",
    className: "s2s-col--day",
  },
  {
    number: "02 · Golden Hour",
    title: "Sunset",
    mood: "Transformation",
    tags: ["Anticipation", "Connection", "Awakening"],
    description:
      "The light shifts, the Signal stirs, and the crowd becomes one. Rage starts to appear. Something is coming.",
    className: "s2s-col--sunset",
  },
  {
    number: "03 · After Dark",
    title: "Night",
    mood: "Release",
    tags: ["Euphoria", "Energy", "Catharsis"],
    description:
      "The Eyes awaken — bass, neon, lasers, fire. Pure release until the last strobe.",
    className: "s2s-col--night",
  },
];

const hiddenPlaces = [
  {
    number: "01",
    name: "The Presence Pit",
    tag: "The heart of the floor",
  },
  {
    number: "02",
    name: "Signal Shore",
    tag: "Beach, after dark",
  },
  {
    number: "03",
    name: "Reset + Hydration",
    tag: "Recharge",
  },
  {
    number: "04",
    name: "VIP Oasis",
    tag: "Elevated",
  },
  {
    number: "05",
    name: "Creator Studio",
    tag: "Capture it",
  },
  {
    number: "06",
    name: "Discovery Corridor",
    tag: "Secrets between zones",
  },
  {
    number: "07",
    name: "Memory Wall",
    tag: "Leave your mark",
  },
];
---

<section
  id="experience"
  class="s2s-section"
  data-scroll-phase="sunset-start"
>
  <div class="s2s-shell">
    <header class="s2s-head">
      <p class="s2s-kicker">The Experience</p>

      <div class="s2s-heading">
        <h2 class="s2s-title">
          <span class="s2s-title__day">One Day</span>
          <span class="s2s-title__accent">Three Transformations</span>
        </h2>

        <p class="s2s-lead">
          Guests don’t watch a lineup — they move through a feeling
        </p>
      </div>
    </header>

    <div class="s2s">
      {
        phases.map((phase) => (
          <article class:list={["s2s-col", phase.className]}>
            <div class="s2s-col__body">
              <span class="s2s-num">{phase.number}</span>
              <h3>{phase.title}</h3>
              <p class="s2s-mood">{phase.mood}</p>

              <ul class="s2s-tags">
                {phase.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>

              <p class="s2s-copy">{phase.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="world-hidden">
      <header class="world-hidden__head">
        <p class="s2s-kicker">The Experience</p>

        <h2 class="s2s-title world-hidden__title">
          <span class="s2s-title__day">What Else</span>
          <span class="s2s-title__accent">Is Hidden There?</span>
        </h2>

        <p class="world-hidden__lead">
          More corners than we’ll show you here. A few places you’ll find
          inside. The rest you discover in person.
        </p>
      </header>

      <div class="world-list">
        {
          hiddenPlaces.map((place) => (
            <div class="world-row">
              <span class="world-row__num">{place.number}</span>
              <span class="world-row__name">{place.name}</span>
              <span class="world-row__tag">{place.tag}</span>
            </div>
          ))
        }
      </div>

      <p class="world-more">
        <img
          class="world-more__eyes"
          src={logoIcon.src}
          alt=""
          width={logoIcon.width}
          height={logoIcon.height}
        />
        <span>And more you’ll only find once you’re inside.</span>
      </p>
    </div>
  </div>
</section>

<script>
  const initExperienceReveal = () => {
    const section = document.querySelector("#experience");
    const cards = Array.from(
      document.querySelectorAll(".s2s-col"),
    );

    if (!section || cards.length === 0) return;
    if (section.dataset.revealReady === "true") return;

    section.dataset.revealReady = "true";

    const showCards = () => {
      if (section.dataset.revealed === "true") return;
      section.dataset.revealed = "true";

      cards.forEach((card, index) => {
        window.setTimeout(() => {
          card.classList.add("is-visible");
        }, index * 900);
      });
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cards.forEach((card) => card.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          showCards();
          observer.disconnect();
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -10% 0px",
      },
    );

    observer.observe(section);

    // Fallback if the section is already on screen when the script runs
    const rect = section.getBoundingClientRect();
    if (rect.top < window.innerHeight * 0.88 && rect.bottom > 0) {
      showCards();
      observer.disconnect();
    }
  };

  initExperienceReveal();
  document.addEventListener("astro:page-load", initExperienceReveal);
</script>
