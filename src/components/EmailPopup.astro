---
import logoIcon from "../assets/navigation/logo-icon.png";
---

<div class="signal-pop" data-signal-pop hidden>
  <div class="signal-pop__backdrop" data-signal-pop-dismiss></div>

  <div class="signal-pop__stage">
    <span class="signal-pop__glow" aria-hidden="true"></span>

    <div
      class="signal-pop__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="signal-pop-title"
      aria-describedby="signal-pop-body"
      data-signal-pop-panel
    >
      <div class="signal-pop__fx" aria-hidden="true">
        <span class="signal-pop__haze"></span>
        <span class="signal-pop__scan"></span>
        <span class="signal-pop__grain"></span>
        <img
          class="signal-pop__mark"
          src={logoIcon.src}
          alt=""
          width={logoIcon.width}
          height={logoIcon.height}
        />
      </div>

      <button
        class="signal-pop__close"
        type="button"
        data-signal-pop-dismiss
        aria-label="Close"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <div class="signal-pop__content" data-signal-pop-form-view>
        <p class="signal-pop__eyebrow">The Signal Is Live</p>

        <h2 id="signal-pop-title" class="signal-pop__title">
          Enter the rage.
        </h2>

        <p id="signal-pop-body" class="signal-pop__text">
          <span class="signal-pop__text-lead"
            >The lineup. The presale. The reveals.</span
          >
          <span class="signal-pop__text-sub"
            >Get first access to everything RAGEFEST.</span
          >
        </p>

        <form class="signal-pop__form" novalidate data-signal-pop-form>
          <label class="visually-hidden" for="signal-pop-email">
            Email address
          </label>

          <input
            id="signal-pop-email"
            class="signal-pop__input"
            type="email"
            name="email"
            placeholder="ENTER YOUR EMAIL"
            autocomplete="email"
            required
          />

          <button
            class="join-waitlist-btn signal-pop__cta"
            type="submit"
            data-signal-pop-submit
          >
            <span>Get Early Access →</span>
          </button>
        </form>

        <p class="signal-pop__status" role="status" data-signal-pop-status hidden>
        </p>

        <p class="signal-pop__fine">Ragefest · South Padre Island · 2027</p>
      </div>

      <div class="signal-pop__done" data-signal-pop-success hidden>
        <p class="signal-pop__done-title">You're in.</p>

        <p class="signal-pop__done-text">
          The signal has been received.<br />
          We'll see you on the island.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { submitWaitlistEmail, isValidEmail } from "../scripts/waitlist";

  const SESSION_KEY = "rf-signal-pop";
  const DELAY_MS = 1500;
  const SCROLL_RATIO = 0.2;

  const initEmailPopup = () => {
    const root = document.querySelector<HTMLElement>("[data-signal-pop]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const panel = root.querySelector<HTMLElement>("[data-signal-pop-panel]");
    const form = root.querySelector<HTMLFormElement>("[data-signal-pop-form]");
    const input = root.querySelector<HTMLInputElement>("#signal-pop-email");
    const submit = root.querySelector<HTMLButtonElement>(
      "[data-signal-pop-submit]",
    );
    const status = root.querySelector<HTMLElement>("[data-signal-pop-status]");
    const formView = root.querySelector<HTMLElement>(
      "[data-signal-pop-form-view]",
    );
    const successView = root.querySelector<HTMLElement>(
      "[data-signal-pop-success]",
    );

    if (!panel || !form || !input || !submit) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let isOpen = false;
    let lastFocused: HTMLElement | null = null;
    let closeTimer: number | undefined;

    const alreadyHandled = () => {
      try {
        return sessionStorage.getItem(SESSION_KEY) !== null;
      } catch {
        return false;
      }
    };

    const remember = (value: "seen" | "joined") => {
      try {
        sessionStorage.setItem(SESSION_KEY, value);
      } catch {
        /* private mode — popup simply may reappear next navigation */
      }
    };

    const setStatus = (message: string, tone: "err" | "idle" = "idle") => {
      if (!status) return;
      status.hidden = !message;
      status.textContent = message;
      status.dataset.tone = tone;
    };

    const lockScroll = () => {
      const gap = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      if (gap > 0) document.body.style.paddingRight = `${gap}px`;
    };

    const unlockScroll = () => {
      document.body.style.overflow = "";
      document.body.style.paddingRight = "";
    };

    const focusable = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          'button, input, a[href], [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((node) => !node.hasAttribute("disabled") && node.offsetParent);

    const open = () => {
      if (isOpen || alreadyHandled()) return;

      isOpen = true;
      remember("seen");
      window.clearTimeout(closeTimer);

      lastFocused = document.activeElement as HTMLElement | null;
      root.hidden = false;
      lockScroll();

      const reveal = () => root.setAttribute("data-open", "true");
      if (reduceMotion) reveal();
      else requestAnimationFrame(() => requestAnimationFrame(reveal));

      const target = successView?.hidden === false ? panel : input;
      window.setTimeout(() => target?.focus({ preventScroll: true }), 80);
    };

    const close = () => {
      if (!isOpen) return;

      isOpen = false;
      root.removeAttribute("data-open");
      unlockScroll();

      const finish = () => {
        root.hidden = true;
      };

      if (reduceMotion) finish();
      else closeTimer = window.setTimeout(finish, 320);

      lastFocused?.focus({ preventScroll: true });
    };

    root.querySelectorAll("[data-signal-pop-dismiss]").forEach((node) => {
      node.addEventListener("click", close);
    });

    document.addEventListener("keydown", (event) => {
      if (!isOpen) return;

      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }

      if (event.key !== "Tab") return;

      const nodes = focusable();
      if (nodes.length === 0) return;

      const first = nodes[0];
      const last = nodes[nodes.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || active === panel)) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const email = input.value.trim();

      if (!isValidEmail(email)) {
        setStatus("Enter a valid email address.", "err");
        input.focus();
        return;
      }

      submit.disabled = true;
      root.dataset.state = "loading";
      setStatus("Sending…");

      const result = await submitWaitlistEmail(email, "popup");

      submit.disabled = false;
      delete root.dataset.state;

      if (!result.ok) {
        setStatus("Something went wrong. Try again in a moment.", "err");
        return;
      }

      setStatus("");
      remember("joined");

      if (formView && successView) {
        formView.hidden = true;
        successView.hidden = false;
        root.dataset.state = "success";
        window.setTimeout(
          () => successView.focus?.({ preventScroll: true }),
          60,
        );
      }
    });

    if (alreadyHandled()) return;

    const timer = window.setTimeout(open, DELAY_MS);

    const onScroll = () => {
      const scrollable =
        document.documentElement.scrollHeight - window.innerHeight;

      if (scrollable <= 0) return;
      if (window.scrollY / scrollable < SCROLL_RATIO) return;

      window.clearTimeout(timer);
      window.removeEventListener("scroll", onScroll);
      open();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
  };

  initEmailPopup();
  document.addEventListener("astro:page-load", initEmailPopup);
</script>
