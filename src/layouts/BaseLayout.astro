---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RAGE FEST 2027 | Sun to Strobe",
  description = "A one-day music and experience festival on South Padre Island, Texas.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-59JL8WMN");
    </script>
    <!-- End Google Tag Manager -->

    <link
      rel="preload"
      href="/fonts/road-rage.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" content="#090713" />

    <link
      rel="stylesheet"
      type="text/css"
      href="https://loop1tickets.com/Ragefest/Ragefest2027/widget/v1.css"
    />
    <script
      is:inline
      type="text/javascript"
      src="https://loop1tickets.com/widget/v1.en.js"
      async
    ></script>
  </head>

  <body class="min-h-screen bg-rf-night text-rf-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-59JL8WMN"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>