---
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import Lineup from "../components/sections/Lineup.astro";
import Tickets from "../components/sections/Tickets.astro";
import Faq from "../components/sections/Faq.astro";
import FestivalScrollProgress from "../components/features/FestivalScrollProgress.astro";
import FestivalSky from "../components/features/FestivalSky.astro";

import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Rage Fest</title>
  </head>

  <body>
    <Header />
    <FestivalScrollProgress />

    <main>
      <Hero />

      <div class="festival-world">
        <FestivalSky />
        <Experience />
        <Lineup />
        <Tickets />
        <Faq />
      </div>
    </main>
  </body>
</html>
