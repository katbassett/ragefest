---
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import Lineup from "../components/sections/Lineup.astro";
import Tickets from "../components/sections/Tickets.astro";
import Signal from "../components/sections/Signal.astro";
import Faq from "../components/sections/Faq.astro";
import FestivalScrollProgress from "../components/features/FestivalScrollProgress.astro";
import FestivalSky from "../components/features/FestivalSky.astro";
import EmailPopup from "../components/EmailPopup.astro";
import Footer from "../components/layout/Footer.astro";
import { ticketShop } from "../data/ticket-shop";

import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-59JL8WMN");
    </script>
    <!-- End Google Tag Manager -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link
      rel="preload"
      href="/fonts/road-rage.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="stylesheet"
      type="text/css"
      href={ticketShop.cssUrl}
    />

    <title>RAGEFEST</title>
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-59JL8WMN"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <FestivalScrollProgress />

    <main>
      <Hero />

      <div class="festival-world">
        <FestivalSky />
        <Lineup />
        <Tickets />
        <Experience />
        <Signal />
        <Faq />
        <Footer />
      </div>
    </main>

    <EmailPopup />

    <script is:inline type="text/javascript" src={ticketShop.jsUrl}></script>
  </body>
</html>
